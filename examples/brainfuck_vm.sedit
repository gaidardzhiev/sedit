"pow10"
[
	dup 0 eq
	[ drop 1 ]
	[
		dup 2 mod 0 eq
		[ 2 div pow10 dup mul ]
		[ 1 sub pow10 10 mul ]
		if
	]
	if
]
def

"emit"
[
	dup 5000 lt
	[
		over 1000 div 10000 mod
		dup 1000 mod 999 lt
		[ 1000 div over 1000 div eq ]
		[ drop false ]
		if
	]
	[ false ]
	if
	[ drop 1000 add ]
	[ swap dup 1000 mod 1 add swap 1000 div 10000 mul rot add 1000 mul add ]
	if
]
def

"+" [ 1001 emit ] def
"-" [ 2001 emit ] def
">" [ 3001 emit ] def
"<" [ 4001 emit ] def
"." [ 7000 emit ] def
"," [ 8000 emit ] def

"loop"
[
	swap 5000 emit
	dup 1000 mod
	rot rot swap
	call
	dup 1000 mod
	rot sub
	dup 4 mul pow10
	mul 1000 mul add
	6000 emit
]
def

"assemble"
[
	1000 div 0 swap
	[ dup 0 gt ]
	[ dup 10000 mod rot 10000 mul add swap 10000 div ]
	while
	drop
]
def

"cell.inc"
[ rot swap 1000 mod over 1000 mod add 256 mod swap 1000 div 1000 mul add swap ]
def

"cell.dec"
[ rot swap 1000 mod over 1000 mod 1024 add swap sub 256 mod swap 1000 div 1000 mul add swap ]
def

"head.right1"
[ over 1000 div 1000 mod swap 1000 mul add swap dup 1000 mod 1 add swap 1000000 div 1000 mul add swap ]
def

"head.left1"
[ dup 1000 mod swap 1000 div rot rot swap dup 1000 mod swap 1000 div 1000 mul rot add 1000 mul swap 1 sub add swap ]
def

"head.right"
[
	rot 10000 mul add swap rot rot
	dup 10000 mod swap 10000 div swap 1000 mod
	[ dup 0 gt ]
	[ 1 sub rot rot head.right1 rot ]
	while
	drop rot
]
def

"head.left"
[
	rot 10000 mul add swap rot rot
	dup 10000 mod swap 10000 div swap 1000 mod
	[ dup 0 gt ]
	[ 1 sub rot rot head.left1 rot ]
	while
	drop rot
]
def

"loop.open"
[
	rot dup 1000 mod rot 1000 mul add rot swap
	dup 1000 mod 0 eq
	[ 1000 div 1000 mod 1 add 4 mul pow10 div ]
	[
		1000 div swap 10000 mul add
		dup 1000 mod 4 mul pow10
		over 10000 div over mod
		rot rot mul add
	]
	if
]
def

"cell.out"
[
	drop rot rot
	over 1000 mod
	over over 3 mul 3 add pow10 mod
	rot rot
	over over 3 mul 3 add pow10 div 1000 mul
	rot 1000 mod add
	swap 3 mul 3 add pow10 mul add
	rot
]
def

"cell.in"
[ drop swap 1000 div 1000 mul swap ]
def

"step"
[
	dup 10000 mod swap 10000 div swap
	dup 1000 div
	dup 1 eq
	[ drop cell.inc ]
	[
		dup 2 eq
		[ drop cell.dec ]
		[
			dup 3 eq
			[ drop head.right ]
			[
				dup 4 eq
				[ drop head.left ]
				[
					dup 5 eq
					[ drop loop.open ]
					[
						dup 7 eq
						[ drop cell.out ]
						[
							8 eq
							[ cell.in ]
							[ drop ]
							if
						]
						if
					]
					if
				]
				if
			]
			if
		]
		if
	]
	if
]
def

