"bf"
[
	assemble
	0 0 rot
	[ dup 0 ne ]
	[ step ]
	while
	drop swap 1000 mod 1 add 3 mul pow10 div
	[ dup 0 gt ]
	[ dup 1000 mod chr swap 1000 div ]
	while
	drop
]
def

"hello"
[
	0
	+ + + + + + + + [ > + + + + [ > + + > + + + > + + + > + < < < <
	- ] loop > + > + > - > > + [ < ] loop < - ] loop > > . > - - -
